# Starknet RPC endpoints — per chain. Copy to .env.local with real values.
# The app always uses the URL for the chain the WALLET is on; a wrong/missing
# per-chain URL surfaces as a visible error at connect time (public fallbacks
# below are used when unset).
VITE_RPC_URL_SEPOLIA=https://starknet-sepolia.public.blastapi.io
VITE_RPC_URL_MAINNET=https://starknet-mainnet.public.blastapi.io

# STRK20 dev money-moves route (/dev/money) and board playground (/dev/board).
# NEVER set in production.
VITE_ENABLE_DEV_MONEY=1

# Family-board relay (apps/server). Default http://localhost:8787.
# VITE_BOARD_URL=

# Optional STRK token address overrides (defaults are canonical mainnet/sepolia STRK).
# VITE_STRK_TOKEN_MAINNET=
# VITE_STRK_TOKEN_SEPOLIA=
